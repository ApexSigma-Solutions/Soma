{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  
  // Advanced configuration - all features enabled
  // For experienced users who want full control
  
  "agents": {
    "Sisyphus": {
      "model": "anthropic/claude-opus-4-5",
      "temperature": 0.3
    },
    "oracle": { 
      "model": "openai/gpt-5.2",
      "permission": {
        "edit": "ask",  // Prompt before editing
        "bash": "allow",
        "external_directory": "deny"
      }
    },
    "librarian": { 
      "model": "anthropic/claude-sonnet-4-5",
      "prompt_append": "Use context7 for docs, grep_app for code examples."
    },
    "explore": { 
      "model": "anthropic/claude-haiku-4-5",
      "permission": {
        "edit": "deny",  // Read-only exploration
        "bash": {
          "git": "allow",
          "rm": "deny"
        }
      }
    },
    "multimodal-looker": { 
      "model": "google/gemini-3-flash-preview" 
    }
  },
  
  "categories": {
    "quick": { "model": "anthropic/claude-haiku-4-5" },
    "visual-engineering": { 
      "model": "google/gemini-3-pro-preview",
      "prompt_append": "Follow project design system. Use shadcn/ui and Tailwind."
    },
    "ultrabrain": { 
      "model": "openai/gpt-5.2-codex",
      "variant": "xhigh"
    },
    "artistry": { 
      "model": "google/gemini-3-pro-preview",
      "variant": "max"
    },
    "writing": { "model": "google/gemini-3-flash-preview" },
    "unspecified-low": { "model": "anthropic/claude-sonnet-4-5" },
    "unspecified-high": { 
      "model": "anthropic/claude-opus-4-5",
      "variant": "max"
    },
    
    // Custom categories for specific domains
    "data-science": {
      "model": "anthropic/claude-sonnet-4-5",
      "temperature": 0.2,
      "prompt_append": "Focus on pandas, numpy, scikit-learn. Use type hints and docstrings."
    },
    "devops": {
      "model": "openai/gpt-5.2",
      "prompt_append": "Prefer Docker, k8s, terraform. Follow 12-factor app methodology."
    }
  },
  
  "background_task": {
    "defaultConcurrency": 5,
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 5,
      "google": 10
    },
    "modelConcurrency": {
      "anthropic/claude-opus-4-5": 2
    }
  },
  
  // Tmux integration for visual multi-agent execution
  "tmux": {
    "enabled": true,
    "layout": "main-vertical",
    "main_pane_size": 60,
    "main_pane_min_width": 120,
    "agent_pane_min_width": 40
  },
  
  "git_master": {
    "commit_footer": true,
    "include_co_authored_by": true
  },
  
  "browser_automation_engine": {
    "provider": "playwright"  // or "agent-browser"
  },
  
  "sisyphus_agent": {
    "disabled": false,
    "default_builder_enabled": false,
    "planner_enabled": true,
    "replace_plan": true
  },
  
  // Disable specific features if needed
  "disabled_hooks": [
    // "comment-checker",
    // "todo-continuation-enforcer"
  ],
  
  "disabled_mcps": [
    // "websearch",
    // "context7"
  ],
  
  "disabled_agents": [
    // "multimodal-looker"
  ],
  
  "disabled_skills": [
    // "playwright"
  ],
  
  // Custom LSP servers
  "lsp": {
    "typescript-language-server": {
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"],
      "priority": 10
    },
    "python-lsp-server": {
      "command": ["pylsp"],
      "extensions": [".py"]
    }
  },
  
  // Experimental features (use with caution)
  "experimental": {
    "truncate_all_tool_outputs": false,
    "aggressive_truncation": false,
    "auto_resume": false
  }
}

# =============================================================================
# Soma Monorepo - Environment Configuration Template
# =============================================================================
# This template provides environment variable configuration for both:
#   - DESKTOP (Central Brain): Services running locally with Docker state layer
#   - LAPTOP (Remote Client): Accessing services on Desktop via Tailscale
#
# USAGE:
#   1. Copy this file to `.env.local` (gitignored)
#   2. Choose your deployment profile below
#   3. Fill in sensitive values from Bitwarden
#
# ARCHITECTURE:
#   - State Layer (Docker): Postgres, Neo4j, Redis (always localhost on Desktop)
#   - Logic Layer (Native): InGest, OmegaKG, memOS (bind to 0.0.0.0 for Tailscale)
# =============================================================================

# --- DEPLOYMENT PROFILE ---
# Choose ONE profile and comment out the other

# === PROFILE 1: DESKTOP (Central Brain) ===
# Use this on the Desktop machine where services are hosted
DEPLOYMENT_PROFILE="desktop"

# Database connections (Docker containers on localhost)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password_from_bitwarden"

POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="omega_user"
POSTGRES_PASSWORD="your_postgres_password_from_bitwarden"
POSTGRES_DB="omega_kg_stable"

REDIS_URL="redis://localhost:6380/0"

# Application endpoints (native services on localhost)
OMEGAKG_API_URL="http://localhost:8765"
INGEST_API_URL="http://localhost:3000"
MEMOS_API_URL="http://localhost:8768"

# Dagster Database URL (for native InGest)
DAGSTER_POSTGRES_HOST="localhost"
DAGSTER_POSTGRES_PORT="5432"
DAGSTER_POSTGRES_USER="omega_user"
DAGSTER_POSTGRES_PASSWORD="your_postgres_password_from_bitwarden"
DAGSTER_POSTGRES_DB="omega_kg_stable"
DAGSTER_PG_URL="postgresql://omega_user:your_postgres_password_from_bitwarden@localhost:5432/omega_kg_stable"

# === PROFILE 2: LAPTOP (Remote Client) ===
# Use this on the Laptop when accessing Desktop services via Tailscale
# DEPLOYMENT_PROFILE="laptop"
#
# # Database connections (via Tailscale to Desktop)
# NEO4J_URI="bolt://sigma-desktop:7687"
# NEO4J_USER="neo4j"
# NEO4J_PASSWORD="your_neo4j_password_from_bitwarden"
#
# POSTGRES_HOST="sigma-desktop"
# POSTGRES_PORT="5432"
# POSTGRES_USER="omega_user"
# POSTGRES_PASSWORD="your_postgres_password_from_bitwarden"
# POSTGRES_DB="omega_kg_stable"
#
# REDIS_URL="redis://sigma-desktop:6380/0"
#
# # Application endpoints (via Tailscale to Desktop services)
# OMEGAKG_API_URL="http://sigma-desktop:8765"
# INGEST_API_URL="http://sigma-desktop:3000"
# MEMOS_API_URL="http://sigma-desktop:8768"
#
# # Dagster Database URL (for remote Dagster client)
# DAGSTER_POSTGRES_HOST="sigma-desktop"
# DAGSTER_POSTGRES_PORT="5432"
# DAGSTER_POSTGRES_USER="omega_user"
# DAGSTER_POSTGRES_PASSWORD="your_postgres_password_from_bitwarden"
# DAGSTER_POSTGRES_DB="omega_kg_stable"
# DAGSTER_PG_URL="postgresql://omega_user:your_postgres_password_from_bitwarden@sigma-desktop:5432/omega_kg_stable"

# =============================================================================
# SHARED CONFIGURATION (All Deployments)
# =============================================================================

# --- Security & API Keys ---
SOMA_INTERNAL_KEY="your_internal_api_key_from_bitwarden"
LINEAR_WEBHOOK_SECRET="your_linear_webhook_secret_from_bitwarden"
GITHUB_TOKEN="your_github_personal_access_token_from_bitwarden"
BWS_ACCESS_TOKEN=""  # Bitwarden Secrets Manager (if using)

# --- Tailscale ---
TS_AUTHKEY="your_tailscale_auth_key_from_bitwarden"

# --- AI/LLM Configuration ---
NANO_GPT_API_KEY="your_nanogpt_api_key_from_bitwarden"
EMBED_API_KEY="ignore-me"  # Placeholder for local embedding models
EMBED_BASE_URL="http://localhost:11434"  # Ollama or local model server
EMBED_MODEL="qwen3-embedding:0.6B-F16"

# --- LanceDB (Vector Store) ---
LANCEDB_URI="/opt/soma/memory/lancedb"  # Docker path (mapped volume)
LANCEDB_TABLE="soma_memories"

# --- Application Settings ---
ZERO_TRUST_REQUIRED="false"  # Enable for production
DAGSTER_HOME="/opt/dagster/dagster_home"  # Docker path for InGest

# --- Obsidian Vault ---
OBSIDIAN_VAULT_PATH="/vault"  # Docker mount path (read-only)

# =============================================================================
# NOTES
# =============================================================================
# 
# PORT MAPPINGS (Desktop):
#   - Postgres:        5432  (exposed on 0.0.0.0)
#   - Neo4j Browser:   7474  (exposed on 0.0.0.0)
#   - Neo4j Bolt:      7687  (exposed on 0.0.0.0)
#   - Redis:           6380  (internal)
#   - InGest (Dagster): 3000  (native, bound to 0.0.0.0)
#   - OmegaKG (Brain):  8765  (native, bound to 0.0.0.0)
#   - memOS:            8768  (native, bound to 0.0.0.0)
#
# TAILSCALE HOSTNAME:
#   - Desktop hostname: sigma-desktop
#   - Laptop should resolve this via Tailscale DNS
#
# STARTUP COMMAND (Desktop):
#   .\scripts\start_brain.ps1
#
# =============================================================================

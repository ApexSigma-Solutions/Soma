# --- Stage 1: The Builder ---
# Use a full image with build tools to install Poetry and dependencies
FROM python:3.12-slim AS builder

# Set environment variables for Poetry
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VENV_IN_PROJECT=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Install system build dependencies and Poetry
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && curl -sSL https://install.python-poetry.org | python3 -

# Add Poetry to PATH
ENV PATH="/root/.local/bin:$PATH"

# Set work directory
WORKDIR /app

# Copy only the dependency files to leverage Docker's layer caching
COPY pyproject.toml poetry.lock ./

# Install dependencies into the project's virtual environment
# This creates a .venv directory in /app
RUN poetry config virtualenvs.in-project true && \
    poetry lock && \
    poetry install --only main --no-root

# --- Stage 2: The Final Image ---
# Use a clean, slim image for the final runtime
FROM python:3.12-slim

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN groupadd --gid 1000 omega && \
    useradd --uid 1000 --gid omega --shell /bin/bash --create-home omega

# Set work directory
WORKDIR /app

# Copy the virtual environment from the builder stage
COPY --from=builder --chown=omega:omega /app/.venv /app/.venv

# Copy the application code
COPY --chown=omega:omega . .

# Switch to the non-root user
USER omega

# Ensure the container uses the Python and dependencies from Poetry's virtual environment
ENV PATH="/app/.venv/bin:$PATH"

# Expose the port for the FastAPI server
EXPOSE 8765

# Health check to ensure the service is running
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8765/health || exit 1

# Define the entrypoint for the container
# This will run the main Omega_KG module using the virtual environment's python
ENTRYPOINT ["python", "-m", "omega_kg.main"]

+        payload = {"note_path": "D:\\projects\\vault\\Tasks\\task.md"}
+
+        # Mock SmartParser where it's used in capture_server
+        with patch("omega_kg.capture_server.SmartParser") as mock_parser_class:
+            mock_parser = MagicMock()

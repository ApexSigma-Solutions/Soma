Subject: [PATCH 2/5] fix(linear_sync): make webhook handler async-safe

The webhook handler was performing blocking I/O (Neo4j + filesystem)
on the FastAPI async event loop, causing performance degradation.
Use run_in_threadpool to execute in background thread.

---
 omega_kg/linear_sync.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/omega_kg/linear_sync.py b/omega_kg/linear_sync.py
index abc1234..def5678 100644
--- a/omega_kg/linear_sync.py
+++ b/omega_kg/linear_sync.py
@@ -1,5 +1,6 @@
 import hmac
 import hashlib
+from starlette.concurrency import run_in_threadpool
 from fastapi import Request, HTTPException, status
 from neo4j import GraphDatabase
 from pathlib import Path
@@ -85,7 +86,8 @@ class LinearSync:
         signature = request.headers.get("Linear-Signature", "")
         if not self._verify_signature(signature, payload_str):
             raise HTTPException(status_code=403, detail="Invalid signature")
-        self.handle_linear_webhook(payload)
+        # Execute blocking I/O in background thread to avoid blocking event loop
+        await run_in_threadpool(self.handle_linear_webhook, payload)
         return {"status": "processed"}

     def _verify_signature(self, signature: str, payload: str) -> bool:


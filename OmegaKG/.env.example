# =============================================================================
# OMEGA_KG ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the actual values.
# See docs/PORT_MAPPING.md for port assignments.
#
# =============================================================================
# ZERO TRUST SECURITY (HYBRID MODE)
# =============================================================================
# Enforce dynamic secret loading from Bitwarden (recommended). Tests can disable
# this in .env.test.
ZERO_TRUST_REQUIRED=true

# OPTION A: ZERO TRUST (RECOMMENDED)
# Set this token to inject secrets directly from Bitwarden at runtime.
# If set, the app will ignore local secret variables and fetch them securely.
# BWS_ACCESS_TOKEN=<place_your_machine_account_token_here>

# Bitwarden Secret IDs (Map these to UUIDs in your Bitwarden Project)
# The app looks for these IDs if BWS_ACCESS_TOKEN is present.
LINEAR_WEBHOOK_SECRET_PRD_ID=<uuid>
POSTGRES_PASSWORD_PRD_ID=<uuid>
NEO4J_PASSWORD_PRD_ID=<uuid>
EXTENSION_API_KEY_PRD_ID=<uuid>
LINEAR_API_KEY_PRD_ID=<uuid>
PERPLEXITY_API_KEY_PRD_ID=<uuid>
GEMINI_API_KEY_PRD_ID=<uuid>
NANOGPT_OMEGAKG_API_KEY=<uuid>
JWT_SECRET_KEY_ID=<uuid>
OLLAMA_OKG_API_KEY_PRD_ID=<uuid>

# =============================================================================
# OPTION B: LEGACY / LOCAL OVERRIDE
# =============================================================================
# If BWS_ACCESS_TOKEN is not set, the app falls back to these plain-text values.

# =============================================================================
# PROJECT INFO
# =============================================================================
PROJECT_NAME=Omega KG
VERSION=4.4.2

# =============================================================================
# ENVIRONMENT MARKER (CRITICAL FOR ISOLATION)
# =============================================================================
OMEGA_ENV=stable

# =============================================================================
# SERVER SETTINGS
# =============================================================================
# Environment: development, test, production
APP_ENV=development
# Host to bind the server to (0.0.0.0 for all interfaces, 127.0.0.1 for localhost only)
APP_HOST=127.0.0.1
# Port for the capture server (default: 8765)
# ⚠️ CRITICAL: This port MUST match the SERVER_URL in your Chrome extension config
# If you change this, update chrome-extension/config.js DEFAULT_CONFIG.SERVER_URL
APP_PORT=8765

# -----------------------------------------------------------------------------
# NGROK / TUNNELING (optional - useful for local testing with public URLs)
# Enable ngrok to create a public tunnel to the local capture server for testing
# in environments where the extension cannot reach localhost directly.
ENABLE_NGROK=false
# Ngrok authtoken (leave blank to use anonymous tunnels). Set this if you need
# a persistent or private ngrok tunnel.
NGROK_API_KEY=

# =============================================================================
# INFRASTRUCTURE (POSTGRES - REQUIRED)
# =============================================================================
POSTGRES_USER=omega_user
POSTGRES_DB=omega_kg
POSTGRES_SERVER=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_PASSWORD=omega_dev_password

# Docker-internal routing (used by docker-compose services)
POSTGRES_SERVER_DOCKER=postgres-db
POSTGRES_PORT_DOCKER=5432
POSTGRES_SERVER_DOCKER_DEV=postgres-dev
POSTGRES_PORT_DOCKER_DEV=5432

# =============================================================================
# INFRASTRUCTURE (REDIS - OPTIONAL FOR PRODUCTION RATE LIMITING)
# =============================================================================
# Use Redis for distributed rate limiting across multiple server processes.
# If not set, falls back to in-memory rate limiting (suitable for single-process development).
# Production deployment: REDIS_URL=redis://localhost:6379/0
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Docker-internal routing (used by docker-compose services)
REDIS_HOST_DOCKER=redis
REDIS_PORT_DOCKER=6379
REDIS_HOST_DOCKER_DEV=redis
REDIS_PORT_DOCKER_DEV=6379

# =============================================================================
# INFRASTRUCTURE (NEO4J - REQUIRED)
# =============================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_secure_password
NEO4J_HEAP_SIZE=512M
NEO4J_HOST_DATA_PATH=./data/neo4j

# Docker-internal routing (used by docker-compose services)
NEO4J_URI_DOCKER=bolt://neo4j-db:7687
NEO4J_URI_DOCKER_DEV=bolt://neo4j-dev:7687

# =============================================================================
# AUTHENTICATION (JWT)
# =============================================================================
# JWT secret key - MUST be a secure random string in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change_me_to_secure_random_string
JWT_ALGORITHM=HS256
# Token expiration in minutes (1440 = 24 hours)
JWT_EXPIRATION_MINUTES=1440

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# API key for browser extension authentication
# ⚠️ CRITICAL: This key is used by the Chrome extension to authenticate with the server
# 1. Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 2. Set this value in .env
# 3. Configure the SAME value in Chrome extension options page
# 4. The extension exchanges this static key for a short-lived JWT token
EXTENSION_API_KEY_PRD=change_me_secure_api_key
EXTENSION_API_KEY=change_me_secure_api_key

# Chrome extension ID for CORS configuration
# ⚠️ Find your extension ID: chrome://extensions (enable Developer mode)
# Format: chrome-extension://<extension-id>
# Leave empty to allow localhost development CORS
CHROME_EXTENSION_ID=your_chrome_extension_id

# =============================================================================
# EMAIL/SMTP (Optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_TO=recipient@example.com

# =============================================================================
# EXTERNAL SERVICES - LINEAR
# =============================================================================
LINEAR_API_KEY=lin_api_placeholder
LINEAR_TEAM_ID=your_team
LINEAR_WORKSPACE_ID=your_workspace
LINEAR_PROJECT_ID=your_project
LINEAR_WEBHOOK_SECRET=lin_wh_placeholder

# JSON Maps for Linear Parsing (optional)
LINEAR_STATUS_MAP_JSON={"in-progress": "state-id", "done": "state-id-2"}
LINEAR_USER_MAP_JSON={}
LINEAR_LABEL_MAP_JSON={}

# =============================================================================
# EXTERNAL SERVICES - GITHUB
# =============================================================================
GITHUB_TOKEN=github_pat_placeholder
GITHUB_WEBHOOK_SECRET=gh_wh_placeholder

# Linear State ID for "Done" (optional)
LINEAR_DONE_STATE_ID=state-id-uuid

# =============================================================================
# EMBEDDING SERVICE (CRITICAL - REQUIRED)
# =============================================================================
# Provider: ollama (local), nanogpt (fallback), gemini (secondary), mock (dev)
EMBEDDING_PROVIDER=ollama
# Ollama Base URL - must match the host where Ollama is running
OLLAMA_BASE_URL=http://0.0.0.0:11434
OLLAMA_EMBEDDING_MODEL=bge-m3:567m
OPENAI_API_KEY=

# =============================================================================
# AI SERVICES
# =============================================================================
# NanoGPT API key (used for AI text generation and embeddings)
NANOGPT_OMEGAKG_API_KEY=your_nanogpt_api_key
# OpenRouter API key (required for routing AI requests)
OPENROUTER_API_KEY=sk-or-v1-placeholder
# Perplexity API key (used for querying Perplexity AI)
PERPLEXITY_API_KEY_PRD=pplx-placeholder
# Gemini API key (required for Google Gemini LLM integration)
GEMINI_API_KEY_PRD=AIza-placeholder
# Ollama API key ID (for Ollama embedding service)
OLLAMA_OKG_API_KEY_PRD_ID=<uuid>

# -----------------------------------------------------------------------------
# HOOKDECK - Optional webhook forwarding/tunneling service
# If you use Hookdeck to receive webhooks or tunnel requests, set your API key
HOOKDECK_API_KEY=hookdeck_key_placeholder
HOOKDECK_PUBLIC_URL=https://hkdk.events/your-unique-url

# =============================================================================
# QUIPU MONITORING (OLLAMA HEARTBEAT)
# =============================================================================
# Ollama host URL for heartbeat monitoring (defaults to OLLAMA_BASE_URL if not set)
OLLAMA_HOST_URL=http://localhost:11434
# Heartbeat check interval in seconds
HEARTBEAT_INTERVAL_SEC=60
# Service identifier for heartbeat records
QUIPU_SERVICE_NAME=ollama-server-01
# Legacy: Direct PostgreSQL connection string (overrides postgres_* fields if set)
OMEGA_PG_CONN=postgresql://user:password@localhost:5432/omega_datalake

# =============================================================================
# LOGIC & KEYWORDS
# =============================================================================
DECISION_KEYWORDS=decided to,chose to,agreed to

# =============================================================================
# CONVERSATION DATALAKE SETTINGS
# =============================================================================

# =============================================================================
# PERCOLATION ENGINE CONFIGURATION
# =============================================================================
# Similarity threshold for creating relationships in the percolation engine (0.0-1.0)
PERCOLATION_SIMILARITY_THRESHOLD=0.8

# =============================================================================
# PATHS
# =============================================================================
# Path to your Obsidian vault (where markdown files are stored)
# Default: ./vault (relative to project root)
# Recommended: Absolute path to d:\projects\omegavault.as
# Example Windows: d:/projects/omegavault.as
# Example Linux: /home/user/projects/omegavault.as
OBSIDIAN_VAULT_PATH=d:/projects/omegavault.as
AI_CONVERSATIONS_PATH=d:/projects/omegavault.as/AI_Conversations
OBSIDIAN_VAULT_SCAN_FOLDERS="Folder1,Folder2,Folder3"
OBSIDIAN_TASK_SCAN_FOLDERS=TN,TNP,Tasks,Workflow,Linear
OBSIDIAN_SESSION_SCAN_FOLDERS=Sessions

# --- Terminal Capture Configuration ---
TERMINAL_NOISE_PATTERNS=^cd\s?,^ls,^dir,^cls,^clear,^echo\s?,^exit,^wsl,^powershell,^ipconfig,^whoami,^Get-Location,^Get-ChildItem

# --- Event Processor Configuration ---
WEBHOOK_POLL_INTERVAL=5.0
WEBHOOK_BATCH_SIZE=10

# --- Ingest Database Configuration (Optional - Defaults to Primary) ---
INGEST_POSTGRES_USER=
INGEST_POSTGRES_PASSWORD=
INGEST_POSTGRES_SERVER=
INGEST_POSTGRES_PORT=
INGEST_POSTGRES_DB=

# -----------------------------------------------------------------------------
# APIDOG CONFIGURATION
# -----------------------------------------------------------------------------
APIDOG_ACCESS_TOKEN=atk_xxxxxxxxxxxxxxxxxxxxxxxxxx
APIDOG_PROJECT_ID=12345678-1234-1234-1234-123456789012

# Optional: On-premise Apidog server
# APIDOG_API_BASE_URL=https://your-on-premise-server.com

# -----------------------------------------------------------------------------
# OMNISEARCH - SEARCH PROVIDERS (Optional - configure only what you need)
# -----------------------------------------------------------------------------

# Tavily - Factual queries with citations
# Get from: https://tavily.com/
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search - Privacy-focused search
# Get from: https://api.search.brave.com/
# BRAVE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kagi Search - High-quality results
# Get from: https://kagi.com/settings
# KAGI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exa AI - Semantic search
# Get from: https://exa.ai/
# EXA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Search - Code and repository search
# Get from: https://github.com/settings/tokens (no scopes needed)
# GITHUB_API_KEY=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OMNISEARCH - AI RESPONSE PROVIDERS
# -----------------------------------------------------------------------------

# Perplexity AI - Real-time web search + AI
# Get from: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kagi FastGPT - Quick AI answers
# (Uses KAGI_API_KEY above)

# Exa Answer - AI-generated responses
# (Uses EXA_API_KEY above)

# -----------------------------------------------------------------------------
# OMNISEARCH - CONTENT PROCESSING
# -----------------------------------------------------------------------------

# Jina AI - Content extraction and grounding
# Get from: https://jina.ai/
# JINA_AI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firecrawl - Web scraping and crawling
# Get from: https://firecrawl.dev/
# FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Self-hosted Firecrawl URL
# FIRECRAWL_BASE_URL=https://your-firecrawl-server.com

# -----------------------------------------------------------------------------
# USAGE INSTRUCTIONS
# -----------------------------------------------------------------------------
# 1. Copy this file to .env in your project root
# 2. Replace all placeholder values with your actual API keys
# 3. Only configure providers you want to use (optional)
# 4. Load environment variables:
#    - Linux/macOS: source .env
#    - Windows: Use your IDE's environment variable support
# 5. Reference in MCP config: ${TAVILY_API_KEY} (not needed if using global env)
#
# NOTE: Omnisearch works without API keys but with limited functionality.
#       For full features, at least one search provider is recommended.

# =============================================================================
# MEMOS MCP SERVER CONFIGURATION
# =============================================================================
# Memos is a privacy-first, lightweight note-taking service
# Get Memos: https://github.com/usememos/memos
#
# Memos server URL (e.g., http://localhost:5230 or https://your-memos-instance.com)
MEMOS_URL=http://localhost:5230
# Memos API key (generate in Memos Settings > API)
MEMOS_API_KEY=your_memos_api_key

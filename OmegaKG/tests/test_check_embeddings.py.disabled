        assert result is not None
        assert result[0] == 42

    @patch("check_embeddings.psycopg2.connect")
    def test_retrieve_embedding_by_chunk_id(self, mock_connect):
        """Test retrieving embedding by chunk_id"""
        mock_conn = Mock()
        mock_cursor = Mock()
        test_embedding = [0.1] * 1024
        mock_cursor.fetchone.return_value = ("test_chunk_1", test_embedding)
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT chunk_id, embedding FROM omega_vectors_1024 " "WHERE chunk_id = %s",
            ("test_chunk_1",),
        )
        result = cursor.fetchone()

        assert result is not None
        assert result[0] == "test_chunk_1"
        assert len(result[1]) == 1024

    @patch("check_embeddings.psycopg2.connect")
    def test_embedding_dimension_validation(self, mock_connect):
        """Test validation of embedding dimensions"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        # Test with wrong dimension (should fail in real scenario)
        wrong_embedding = [0.1] * 512  # Wrong size
        mock_conn.cursor().__enter__()

        # In a real scenario, this would raise an error
        # We're testing that the dimension mismatch is detectable
        assert len(wrong_embedding) != 1024


class TestVectorSimilaritySearch:
    """Tests for vector similarity search operations"""

    @patch("check_embeddings.psycopg2.connect")
    def test_cosine_similarity_search(self, mock_connect):
        """Test cosine similarity search"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchall.return_value = [
            ("chunk_1", 0.95),
            ("chunk_2", 0.87),
            ("chunk_3", 0.82),
        ]
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        query_vector = [0.1] * 1024
        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT chunk_id, 1 - (embedding <=> %s::vector) as similarity "
            "FROM omega_vectors_1024 "
            "ORDER BY embedding <=> %s::vector "
            "LIMIT 3",
            (query_vector, query_vector),
        )
        results = cursor.fetchall()

        assert len(results) == 3
        assert results[0][1] > results[1][1]  # Check ordering
        assert results[1][1] > results[2][1]

    @patch("check_embeddings.psycopg2.connect")
    def test_similarity_search_with_threshold(self, mock_connect):
        """Test similarity search with threshold filter"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchall.return_value = [("chunk_1", 0.95), ("chunk_2", 0.87)]
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        query_vector = [0.1] * 1024
        threshold = 0.8
        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT chunk_id, 1 - (embedding <=> %s::vector) as similarity "
            "FROM omega_vectors_1024 "
            "WHERE 1 - (embedding <=> %s::vector) > %s "
            "ORDER BY embedding <=> %s::vector",
            (query_vector, query_vector, threshold, query_vector),
        )
        results = cursor.fetchall()

        # All results should be above threshold
        for result in results:
            assert result[1] > threshold


class TestIndexOperations:
    """Tests for vector index operations"""


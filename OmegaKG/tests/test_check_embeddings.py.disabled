class TestPerformanceMetrics:
    """Tests for performance monitoring and metrics"""

    @patch("check_embeddings.psycopg2.connect")
    def test_measure_table_size(self, mock_connect):
        """Test measuring table size"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchone.return_value = ("42 MB",)
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT pg_size_pretty(pg_total_relation_size('omega_vectors_1024'))"
        )
        result = cursor.fetchone()

        assert result is not None
        assert "MB" in result[0] or "KB" in result[0] or "GB" in result[0]

    @patch("check_embeddings.psycopg2.connect")
    def test_check_index_usage(self, mock_connect):
        """Test checking index usage statistics"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchone.return_value = (100, 50)  # (index scans, sequential scans)
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT idx_scan, seq_scan FROM pg_stat_user_tables "
            "WHERE relname = 'omega_vectors_1024'"
        )
        result = cursor.fetchone()

        assert result is not None
        assert result[0] >= 0  # index scans
        assert result[1] >= 0  # sequential scans


# Integration-style tests (if database is available)
class TestEndToEndWorkflow:
    """End-to-end workflow tests (requires database)"""

    @pytest.mark.integration
    @patch("check_embeddings.psycopg2.connect")
    def test_complete_embedding_workflow(self, mock_connect):
        """Test complete workflow: create, insert, query, delete"""
        mock_conn = Mock()
        mock_cursor = Mock()

        # Setup mock responses for different operations
        mock_cursor.fetchone.side_effect = [
            ("vector",),  # Extension check
            ("omega_vectors_1024",),  # Table check
            (0,),  # Initial count
            (1,),  # Count after insert
            ("test_chunk", [0.1] * 1024),  # Retrieve
            (0,),  # Count after delete
        ]
        mock_cursor.fetchall.return_value = [("similar_chunk", 0.9)]

        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()

        # 1. Check extension
        cursor.execute("SELECT extname FROM pg_extension WHERE extname = 'vector'")
        assert cursor.fetchone()[0] == "vector"

        # 2. Check table
        cursor.execute(
            "SELECT tablename FROM pg_tables WHERE tablename = 'omega_vectors_1024'"
        )
        assert cursor.fetchone()[0] == "omega_vectors_1024"

        # 3. Count (before)
        cursor.execute("SELECT COUNT(*) FROM omega_vectors_1024")
        assert cursor.fetchone()[0] == 0

        # 4. Insert
        cursor.execute(
            "INSERT INTO omega_vectors_1024 (chunk_id, embedding) VALUES (%s, %s)",
            ("test_chunk", [0.1] * 1024),
        )

        # 5. Count (after insert)
        cursor.execute("SELECT COUNT(*) FROM omega_vectors_1024")
        assert cursor.fetchone()[0] == 1

        # 6. Retrieve
        cursor.execute(
            "SELECT chunk_id, embedding FROM omega_vectors_1024 WHERE chunk_id = %s",
            ("test_chunk",),
        )
        result = cursor.fetchone()
        assert result[0] == "test_chunk"

        # 7. Similarity search
        cursor.execute(
            "SELECT chunk_id, 1 - (embedding <=> %s::vector) as similarity "
            "FROM omega_vectors_1024 ORDER BY embedding <=> %s::vector LIMIT 5",
            ([0.1] * 1024, [0.1] * 1024),
        )
        results = cursor.fetchall()
        assert len(results) > 0

        # 8. Delete
        cursor.execute(
            "DELETE FROM omega_vectors_1024 WHERE chunk_id = %s", ("test_chunk",)
        )

        # 9. Count (after delete)
        cursor.execute("SELECT COUNT(*) FROM omega_vectors_1024")
        assert cursor.fetchone()[0] == 0


if __name__ == "__main__":
    pytest.main([__file__, "-v", "--tb=short"])
    pytest.main([__file__, "-v", "--tb=short"])

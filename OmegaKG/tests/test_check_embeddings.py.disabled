"""
Comprehensive unit tests for check_embeddings.py

This module tests the embedding verification and diagnostic functionality
for the Omega_KG system, including PostgreSQL vector operations and
pgvector extension validation.
"""

import sys
from pathlib import Path
from unittest.mock import Mock, patch

import pytest

# Add project root to path
sys.path.insert(0, str(Path(__file__).parent.parent))

import check_embeddings


class TestDatabaseConnection:
    """Tests for database connection and setup"""

    @patch("check_embeddings.psycopg2.connect")
    def test_database_connection_success(self, mock_connect):
        """Test successful database connection"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_conn.cursor.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        # This would be called in the main function
        conn = check_embeddings.psycopg2.connect(
            host="localhost",
            port=5432,
            database="test_db",
            user="test_user",
            password="test_pass",
        )

        assert conn is not None
        mock_connect.assert_called_once()

    @patch("check_embeddings.psycopg2.connect")
    def test_database_connection_failure(self, mock_connect):
        """Test database connection failure handling"""
        mock_connect.side_effect = Exception("Connection refused")

        with pytest.raises(Exception, match="Connection refused"):
            check_embeddings.psycopg2.connect(
                host="localhost",
                port=5432,
                database="test_db",
                user="test_user",
                password="test_pass",
            )

    @patch("check_embeddings.psycopg2.connect")
    def test_database_connection_with_invalid_credentials(self, mock_connect):
        """Test connection with invalid credentials"""
        mock_connect.side_effect = check_embeddings.psycopg2.OperationalError(
            "FATAL:  password authentication failed"
        )

        with pytest.raises(check_embeddings.psycopg2.OperationalError):
            check_embeddings.psycopg2.connect(
                host="localhost",
                port=5432,
                database="test_db",
                user="wrong_user",
                password="wrong_pass",
            )


class TestPgvectorExtension:
    """Tests for pgvector extension validation"""

    @patch("check_embeddings.psycopg2.connect")
    def test_check_pgvector_extension_exists(self, mock_connect):
        """Test checking if pgvector extension exists"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchone.return_value = ("vector",)
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        # Simulate checking extension
        cursor = mock_conn.cursor().__enter__()
        cursor.execute("SELECT * FROM pg_extension WHERE extname = 'vector'")
        result = cursor.fetchone()

        assert result is not None
        assert result[0] == "vector"

    @patch("check_embeddings.psycopg2.connect")
    def test_check_pgvector_extension_missing(self, mock_connect):
        """Test detection of missing pgvector extension"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchone.return_value = None
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute("SELECT * FROM pg_extension WHERE extname = 'vector'")
        result = cursor.fetchone()

        assert result is None


class TestTableValidation:
    """Tests for table and column validation"""

    @patch("check_embeddings.psycopg2.connect")
    def test_check_omega_vectors_table_exists(self, mock_connect):
        """Test checking if omega_vectors_1024 table exists"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchone.return_value = ("omega_vectors_1024",)
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT tablename FROM pg_tables " "WHERE tablename = 'omega_vectors_1024'"
        )
        result = cursor.fetchone()

        assert result is not None
        assert result[0] == "omega_vectors_1024"

    @patch("check_embeddings.psycopg2.connect")
    def test_check_vector_column_type(self, mock_connect):
        """Test validation of vector column data type"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchall.return_value = [
            ("id", "integer"),
            ("chunk_id", "character varying"),
            ("embedding", "vector(1024)"),
            ("created_at", "timestamp with time zone"),
        ]
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT column_name, data_type FROM information_schema.columns "
            "WHERE table_name = 'omega_vectors_1024'"
        )
        columns = cursor.fetchall()

        # Find the embedding column
        embedding_col = next((col for col in columns if col[0] == "embedding"), None)
        assert embedding_col is not None
        assert "vector" in embedding_col[1]

    @patch("check_embeddings.psycopg2.connect")
    def test_check_table_missing(self, mock_connect):
        """Test detection of missing table"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.fetchone.return_value = None
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT tablename FROM pg_tables " "WHERE tablename = 'omega_vectors_1024'"
        )
        result = cursor.fetchone()

        assert result is None


class TestEmbeddingOperations:
    """Tests for embedding storage and retrieval operations"""

    @patch("check_embeddings.psycopg2.connect")

        )

        cursor.execute.assert_called_once()
        assert "CREATE INDEX" in cursor.execute.call_args[0][0]
        assert "ivfflat" in cursor.execute.call_args[0][0]


class TestErrorHandling:
    """Tests for error handling and edge cases"""

    @patch("check_embeddings.psycopg2.connect")
    def test_handle_connection_timeout(self, mock_connect):
        """Test handling connection timeout"""
        mock_connect.side_effect = check_embeddings.psycopg2.OperationalError(
            "could not connect to server: Connection timed out"
        )

        with pytest.raises(check_embeddings.psycopg2.OperationalError):
            check_embeddings.psycopg2.connect(
                host="unreachable_host",
                port=5432,
                database="test_db",
                user="test_user",
                password="test_pass",
            )

    @patch("check_embeddings.psycopg2.connect")
    def test_handle_invalid_vector_format(self, mock_connect):
        """Test handling invalid vector format"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.execute.side_effect = check_embeddings.psycopg2.DataError(
            "invalid input syntax for type vector"
        )
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()

        with pytest.raises(check_embeddings.psycopg2.DataError):
            cursor.execute(
                "INSERT INTO omega_vectors_1024 (chunk_id, embedding) "
                "VALUES (%s, %s)",
                ("test_chunk", "not_a_vector"),
            )

    @patch("check_embeddings.psycopg2.connect")
    def test_handle_null_embedding(self, mock_connect):
        """Test handling NULL embedding values"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        # Test inserting NULL embedding (if allowed by schema)
        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "INSERT INTO omega_vectors_1024 (chunk_id, embedding) " "VALUES (%s, %s)",
            ("test_chunk", None),
        )

        # Verify the call was made (actual NULL handling depends on schema)
        cursor.execute.assert_called_once()

    @patch("check_embeddings.psycopg2.connect")
    def test_handle_duplicate_chunk_id(self, mock_connect):
        """Test handling duplicate chunk_id insertion"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_cursor.execute.side_effect = check_embeddings.psycopg2.IntegrityError(
            "duplicate key value violates unique constraint"
        )
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()

        with pytest.raises(check_embeddings.psycopg2.IntegrityError):
            cursor.execute(
                "INSERT INTO omega_vectors_1024 (chunk_id, embedding) "
                "VALUES (%s, %s)",
                ("duplicate_chunk", [0.1] * 1024),
            )



        mock_conn = Mock()
        mock_cursor = Mock()
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        # Simulate inserting an embedding
        test_embedding = [0.1] * 1024
        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "INSERT INTO omega_vectors_1024 (chunk_id, embedding) " "VALUES (%s, %s)",
            ("test_chunk_1", test_embedding),
        )

        cursor.execute.assert_called_once()
        assert "INSERT INTO omega_vectors_1024" in cursor.execute.call_args[0][0]

    @patch("check_embeddings.psycopg2.connect")
    def test_query_embeddings_count(self, mock_connect):
        """Test querying total embedding count"""
        mock_conn = Mock()

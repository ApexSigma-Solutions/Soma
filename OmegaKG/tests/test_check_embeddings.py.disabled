        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "SELECT indexname FROM pg_indexes "
            "WHERE tablename = 'omega_vectors_1024' "
            "AND indexname LIKE '%embedding%'"
        )
        result = cursor.fetchone()

        assert result is not None
        assert "embedding" in result[0]

    @patch("check_embeddings.psycopg2.connect")
    def test_create_ivfflat_index(self, mock_connect):
        """Test creating IVFFlat index"""
        mock_conn = Mock()
        mock_cursor = Mock()
        mock_conn.cursor.return_value.__enter__.return_value = mock_cursor
        mock_connect.return_value = mock_conn

        cursor = mock_conn.cursor().__enter__()
        cursor.execute(
            "CREATE INDEX IF NOT EXISTS omega_vectors_1024_embedding_idx "

# ============================================================================
# InGest-LLM.as - Environment Configuration
# ============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env
# 2. Fill in the required secrets (marked with <...>)
# 3. Never commit the actual .env file to version control
# ============================================================================

# =============================================================================
# ZERO TRUST SECURITY (HYBRID MODE)
# =============================================================================
# Enforce dynamic secret loading from Bitwarden (recommended). Tests can disable
# this in .env.test.
ZERO_TRUST_REQUIRED=true
# =============================================================================
# OPTION A: ZERO TRUST (RECOMMENDED)
# Set this token to inject secrets directly from Bitwarden at runtime.
# If set, the app will ignore local secret variables and fetch them securely.
# BWS_ACCESS_TOKEN=<place_your_machine_account_token_here>
# =============================================================================
# Bitwarden Secret IDs (Map these to UUIDs in your Bitwarden Project)
# The app looks for these IDs if BWS_ACCESS_TOKEN is present.
LINEAR_WEBHOOK_SECRET_PRD_ID=<uuid>
POSTGRES_PASSWORD_PRD_ID=<uuid>
NEO4J_PASSWORD_PRD_ID=<uuid>
EXTENSION_API_KEY_PRD_ID=<uuid>
LINEAR_API_KEY_PRD_ID=<uuid>
PERPLEXITY_API_KEY_PRD_ID=<uuid>
GEMINI_API_KEY_PRD_ID=<uuid>
NANOGPT_OMEGAKG_API_KEY=<uuid>
JWT_SECRET_KEY_ID=<uuid>
OLLAMA_OKG_API_KEY_PRD_ID=<uuid>

# =============================================================================
# OPTION B: LEGACY / LOCAL OVERRIDE
# =============================================================================
# If BWS_ACCESS_TOKEN is not set, the app falls back to these plain-text values.

#=============================================================================
#Service Identity & Core Settings
#=============================================================================
APP_NAME="InGest-LLM.as"
APP_VERSION="0.1.0"
APP_ENV="development" # Options: development | staging | production

#=============================================================================
#Security & Webhooks (CRITICAL)
#=============================================================================
The secret used to sign payloads from Linear.
Retrieve this from Linear > Settings > API > Webhooks > [Your Webhook]
LINEAR_WEBHOOK_SECRET=<YOUR_LINEAR_WEBHOOK_SECRET>
#=============================================================================
#Database (Persistence Layer)
#=============================================================================
#Connection string for PostgreSQL (Used for Dead Letter Queue / Failed Webhooks)
#Format: postgresql://user:password@host:port/dbname
POSTGRES_DSN=postgresql://user:password@localhost:5432/ingest_db

# ============================================================================
# Integration: memOS.as
# ============================================================================
# Base URL for the Memory Operating System
Local Dev: http://localhost:8091
# Docker: http://devenviro_memos_api:8090
INGEST_MEMOS_BASE_URL=http://localhost:8091
INGEST_MEMOS_API_KEY=<YOUR_MEMOS_API_KEY>
INGEST_MEMOS_TIMEOUT=30
INGEST_MEMOS_ENABLED=true

# =============================================================================
# EMBEDDING SERVICE OLLAMA (Local Embeddings)
# =============================================================================
# Enable local embedding generation via Ollama
INGEST_EMBEDDING_ENABLED=true
# Local Dev (Host): http://172.22.144.1:1434 (WSL2 Host IP usually)
# Docker Network: http://host.docker.internal:1434

INGEST_OLLAMA_BASE_URL=http://0.0.0.0:11434
INGEST_OLLAMA_API_KEY=ollama
INGEST_OLLAMA_TIMEOUT=30
INGEST_OLLAMA_ENABLED=true

# =============================================================================
# EMBEDDING PARAMETERS
# =============================================================================

INGEST_EMBEDDING_BATCH_SIZE=10
INGEST_EMBEDDING_DIMENSION=768

# =============================================================================
# QUIPU MONITORING (OLLAMA HEARTBEAT)
# =============================================================================
# Ollama host URL for heartbeat monitoring (defaults to OLLAMA_BASE_URL if not set)
OLLAMA_HOST_URL=http://localhost:11434
# Heartbeat check interval in seconds
HEARTBEAT_INTERVAL_SEC=60
# Service identifier for heartbeat records
QUIPU_SERVICE_NAME=ollama-server-01
# Legacy: Direct PostgreSQL connection string (overrides postgres_* fields if set)
_PG_CONN=postgresql://user:password@localhost:5432/omega_datalake

# =============================================================================
# CONTENT PROCESSING LIMITS
# =============================================================================

DEFAULT_CHUNK_SIZE=1000
MAX_CONTENT_SIZE=10000000
MAX_CHUNKS_PER_REQUEST=100
# Maximum total payload size for DoS protection (5MB default)
INGEST_MAX_PAYLOAD_SIZE=5000000

# =============================================================================
# AI SERVICES
# =============================================================================
# NanoGPT API key (used for AI text generation and embeddings)
NANOGPT_API_KEY=your_nanogpt_api_key
# OpenRouter API key (required for routing AI requests)
OPENROUTER_API_KEY=sk-or-v1-placeholder
# Perplexity API key (used for querying Perplexity AI)
PERPLEXITY_API_KEY_PRD=pplx-placeholder
# Gemini API key (required for Google Gemini LLM integration)
GEMINI_API_KEY_PRD=AIza-placeholder
# Ollama API key ID (for Ollama embedding service)
OLLAMA_API_KEY_PRD_ID=<uuid>

# =============================================================================
# PATHS
# =============================================================================
# Path to your Obsidian vault (where markdown files are stored)
# Default: ./vault (relative to project root)
# Recommended: Absolute path to d:\projects\omegavault.as
# Example Windows: d:/projects/omegavault.as
# Example Linux: /home/user/projects/omegavault.as
OBSIDIAN_VAULT_PATH=d:/projects/omegavault.as
AI_CONVERSATIONS_PATH=d:/projects/omegavault.as/AI_Conversations
OBSIDIAN_VAULT_SCAN_FOLDERS="Folder1,Folder2,Folder3"

# =============================================================================
# APIDOG CONFIGURATION
# =============================================================================
APIDOG_ACCESS_TOKEN=atk_xxxxxxxxxxxxxxxxxxxxxxxxxx
APIDOG_PROJECT_ID=12345678-1234-1234-1234-123456789012

# Optional: On-premise Apidog server
# APIDOG_API_BASE_URL=https://your-on-premise-server.com

# =============================================================================
# OMNISEARCH - SEARCH PROVIDERS (Optional - configure only what you need)
# =============================================================================

# Tavily - Factual queries with citations
# Get from: https://tavily.com/
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search - Privacy-focused search
# Get from: https://api.search.brave.com/
# BRAVE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kagi Search - High-quality results
# Get from: https://kagi.com/settings
# KAGI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Exa AI - Semantic search
# Get from: https://exa.ai/
# EXA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Search - Code and repository search
# Get from: https://github.com/settings/tokens (no scopes needed)
# GITHUB_API_KEY=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# OMNISEARCH - AI RESPONSE PROVIDERS
# =============================================================================

# Perplexity AI - Real-time web search + AI
# Get from: https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kagi FastGPT - Quick AI answers
# (Uses KAGI_API_KEY above)

# Exa Answer - AI-generated responses
# (Uses EXA_API_KEY above)

# =============================================================================
# OMNISEARCH - CONTENT PROCESSING
# =============================================================================

# Jina AI - Content extraction and grounding
# Get from: https://jina.ai/
# JINA_AI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firecrawl - Web scraping and crawling
# Get from: https://firecrawl.dev/
# FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Self-hosted Firecrawl URL
# FIRECRAWL_BASE_URL=https://your-firecrawl-server.com

# =============================================================================
# WEBHOOK CONFIGURATION (LINEAR / GITHUB)
# =============================================================================
# Webhook Configuration
# Linear webhook secret for signature verification
# Get this from Linear Settings -> API -> Webhooks when creating a webhook
# LINEAR_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET=<YOUR_GITHUB_WEBHOOK_SECRET>

# Webhook forwarder configuration
# URL of the ingest-llm service to forward webhooks to
# For Docker Compose:
FORWARDER_INGEST_LLM_URL=http://ingest-llm:8000
# For local development (if ingest-llm is running locally):
# FORWARDER_INGEST_LLM_URL=http://localhost:8001
FORWARDER_TIMEOUT=5

# Circuit Breaker Configuration (for webhook processing)
CIRCUIT_BREAKER_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT=300

# Dead Letter Queue Configuration
# PostgreSQL connection string for DLQ persistence
# POSTGRES_DSN=

# =============================================================================
# OmegaKG INTEGRATION (TN-CORE-103)
# =============================================================================
# Base URL for the OmegaKG validation API
# SECURITY: Use HTTPS in production to protect bearer token transmission
# HTTP is only allowed for localhost/127.0.0.1 development environments
INGEST_OMEGAKG_API_URL=http://localhost:8765
# Service authentication token (Zero Trust)
# SECURITY WARNING: NEVER commit real tokens to version control
# Use Bitwarden Secrets Manager (BWS) in production environments
BWS_ACCESS_TOKEN=<your_bws_token>
# For local development only - use a secure random token generator
# Example: openssl rand -hex 32
STATIC_SERVICE_TOKEN=<generate_secure_random_token>

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env in your project root
# 2. Replace all placeholder values with your actual API keys
# 3. Only configure providers you want to use (optional)
# 4. Load environment variables:
#    - Linux/macOS: source .env
#    - Windows: Use your IDE's environment variable support
# 5. Reference in MCP config: ${TAVILY_API_KEY} (not needed if using global env)
#
# NOTE: Omnisearch works without API keys but with limited functionality.
#       For full features, at least one search provider is recommended.

